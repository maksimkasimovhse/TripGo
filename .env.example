HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=2s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=3m
SHUTDOWN_TIMEOUT=10s

LOG_LEVEL=info

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:22318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TIMEOUT=2000
OTEL_BSP_SCHEDULE_DELAY=1000
OTEL_BSP_EXPORT_TIMEOUT=2000
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_METRIC_EXPORT_TIMEOUT=2000
OTEL_TRACES_SAMPLER=parentbased_always_on
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1

DATABASE_URL=postgres://tripgo:tripgo@localhost:5432/tripgo?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_QUERY_TIMEOUT=3s
